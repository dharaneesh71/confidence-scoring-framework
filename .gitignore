# ===========================
# 1. PYTHON & VENV STANDARD
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/

# ===========================
# 2. ENVIRONMENT VARIABLES (Secrets)
# ===========================
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ===========================
# 3. AI MODELS & HEAVY FILES (Crucial!)
# ===========================
# Ignore Hugging Face cache directories (The one that blocked your push)
backend/hf_*/
hf_*/

# Ignore large model weights
*.bin
*.pth
*.pt
*.onnx
*.safetensors
!backend/models/
weights/

# ===========================
# 4. DATABASES & STORAGE
# ===========================
# SQLite (SQLAlchemy)
*.sqlite
*.sqlite3
*.db
backend/data/*.db

# ChromaDB (Vector Store)
backend/data/chroma_db/
chroma.sqlite3

# PDF Uploads (Don't track user files)
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# ===========================
# 5. FRONTEND (React/Node)
# ===========================
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================
# 6. IDE & SYSTEM JUNK
# ===========================
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db