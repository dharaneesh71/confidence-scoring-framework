# ============================================================
# CONFID.AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ============================================================

# ── Security (REQUIRED) ──────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="121c3e63373d0fdc9a6d88a6342308accfeecdea7b27a71d50740365f9750c79"

# ── HuggingFace (REQUIRED for LLaMA) ────────────────────────────────────────
# Get your token at https://huggingface.co/settings/tokens
# Must have access to meta-llama/Meta-Llama-3.1-8B-Instruct
HUGGINGFACE_TOKEN="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"

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Confidence Scoring Framework
APP_VERSION=1.0.0
DEBUG_MODE=false
LOG_LEVEL=INFO

# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS — add your CS Launch frontend URL here ──────────────────────────────
# Example: ALLOWED_ORIGINS=["https://myapp.cs.vt.edu","http://localhost:3000"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── AI Model ─────────────────────────────────────────────────────────────────
LLAMA_MODEL_NAME=meta-llama/Meta-Llama-3.1-8B-Instruct

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=confidence_documents

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=3

# ── Confidence thresholds ─────────────────────────────────────────────────────
HIGH_CONFIDENCE_THRESHOLD=0.75
MEDIUM_CONFIDENCE_THRESHOLD=0.5

# ── File upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIRECTORY=./data/uploads